DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/bilwacorp_hub
DB_SSL_MODE=disable
SECRET_KEY=change-me-32-chars-minimum-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=["http://localhost:5174"]
REDIS_URL=redis://localhost:6379

LOG_LEVEL=INFO
APP_ENV=development
FRONTEND_URL=http://localhost:5174

# ── Authentik SSO — required, no fallback. Staff login is OIDC-only; see
#    docs/adr/ADR-012-authentik-sso.md. AUTHENTIK_ISSUER is the OIDC
#    provider's issuer URL (Authentik's application slug, e.g.
#    https://auth.bilwacorp.example/application/o/fleet-hub/); create the
#    OAuth2/OpenID provider + application in Authentik first, then fill
#    these in from it. AUTHENTIK_REDIRECT_URI must exactly match the
#    redirect URI registered on the Authentik application. ──
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_ENCRYPTION_KEY=

# ── Only the root docker-compose.yml uses these (Dokploy Compose deploy).
#    Ignored when running uvicorn directly. ──
# HUB_PUBLIC_URL=https://hub.bilwacorp.example
# DOKPLOY_NETWORK_SUBNET=10.x.0.0/16   # dokploy-network's CIDR, from Dokploy

# ── services/notifications/ — staff email + WhatsApp alerts. See
#    backend/app/services/notifications/README.md for setup + per-vendor
#    WhatsApp examples. Needs a real local Redis + a running Celery worker
#    (celery -A app.services.notifications.tasks:celery_app worker) — the
#    Casbin watcher's REDIS_URL above degrades gracefully without Redis,
#    this one does not. ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
NOTIFICATIONS_ENABLED=true
WHATSAPP_NOTIFICATIONS_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_TLS=true
FROM_EMAIL=alerts@bilwacorp.example
FROM_NAME=BilwaCorp Fleet Hub
REPLY_TO=

WHATSAPP_API_URL=
WHATSAPP_API_METHOD=POST
WHATSAPP_API_KEY=
WHATSAPP_AUTH_HEADER=Authorization
WHATSAPP_AUTH_SCHEME=Bearer
WHATSAPP_EXTRA_HEADERS=
WHATSAPP_PAYLOAD_TEMPLATE={"to": "{{ to }}", "message": {{ message | tojson }}}

# ── app/integrations/github/ — optional "Connect with GitHub" app-
#    install auth mode, alongside the always-available personal-access-
#    token mode. See docs/integrations/github.md's "GitHub App auth
#    mode" + docs/adr/ADR-004-github-app-auth.md. Leave GITHUB_APP_ID
#    empty to leave this mode unconfigured. ──
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
